includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    phpVersion: 70400
    paths:
        - wp-user-activity.php
        - wp-user-activity
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    tmpDir: build/phpstan
    parallel:
        maximumNumberOfProcesses: 1
