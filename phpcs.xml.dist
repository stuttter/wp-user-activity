<?xml version="1.0"?>
<ruleset name="WP User Activity">
    <description>WordPress Coding Standards for WP User Activity.</description>

    <file>wp-user-activity.php</file>
    <file>wp-user-activity</file>
    <file>scripts</file>
    <file>tests</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <rule ref="WordPress"/>

    <config name="minimum_supported_wp_version" value="5.2"/>
</ruleset>
